# Zaoly standalone — copy to apps/web/.env.local
# No Plexon / Brandion. Local boot needs none of the suite adapters.

# Public origin (optional; defaults to http://localhost:3009)
# NEXT_PUBLIC_ZAOLY_URL=http://localhost:3009
# Public contact mailbox for website product and enterprise enquiries (defaults to hey@zaoly.app).
# NEXT_PUBLIC_ZAOLY_CONTACT_EMAIL=hey@zaoly.app

# In-app editor (default on outside production)
# ZAOLY_EDITOR_INAPP=1

# Local users (Postgres). Public signup + optional Google + bootstrap admin.
# ZAOLY_DATABASE_URL=postgresql://zaoly:zaoly@localhost:5434/zaoly
# ZAOLY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ZAOLY_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# AUTH_SECRET=replace-with-32+-char-secret
# Public origin for OAuth callbacks (production: https://zaoly.app)
# AUTH_URL=http://localhost:3009
# Optional Google OAuth (Auth.js). Both required to show “Continue with Google”.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Kill-switch for public self-registration (default on when DB is set)
# ZAOLY_PUBLIC_SIGNUP=1

# Optional system mail (admin invites). Spec: specs/domain/zaoly-system-mail.md
# Local: docker compose up -d mailpit → UI http://localhost:8025 (paths.localMailpitUiOrigin)
# ZAOLY_SMTP_HOST=127.0.0.1
# ZAOLY_SMTP_PORT=1025
# ZAOLY_SMTP_FROM=noreply@zaoly.local
# ZAOLY_SMTP_FROM_NAME=Zaoly
# ZAOLY_SMTP_TLS=none
# Hosted zaoly.app: dedicated MTA mail.zaoly.app (+ ZAOLY_SMTP_MANAGED=1).
# Self-host: either set these OR use Settings → Mail (leave MANAGED unset).
# ZAOLY_SMTP_MANAGED=1
# ZAOLY_SMTP_HOST=mail.zaoly.app
# ZAOLY_SMTP_PORT=25
# ZAOLY_SMTP_FROM=noreply@zaoly.app
# ZAOLY_SMTP_FROM_NAME=Zaoly
# ZAOLY_SMTP_TLS=none

# Single-actor DX without login (non-production only). Default on when DB unset.
# ZAOLY_AUTH_BYPASS=1
# ZAOLY_STANDALONE=1

# JSON scene fallback when DB unset (Dev/Tests):
# ZAOLY_SCENE_STORE_PATH=.data/scenes.json

# Legacy CREATION_* aliases still resolve via runtime-config envGet (local names only).

# Zaoly env template — copy to deploy/.env (never commit filled values).
#
# Profiles (knowledge/zaoly-hosted-vs-self-host.md):
#   A Hosted  — scripts/deploy-weddy.sh seeds secrets on the weddy VPS
#   B Self-host — fill this file yourself · knowledge/self-host.md
#     docker compose -f deploy/docker-compose.self-host.yml --env-file deploy/.env up -d --build

# Public origin (Auth.js + absolute links). Self-host: your domain or http://localhost:3000
NEXT_PUBLIC_ZAOLY_URL=https://zaoly.example.com
AUTH_URL=https://zaoly.example.com
ZAOLY_STANDALONE=1
PORT=3000
# Host port for self-host compose (default 3000)
# ZAOLY_HOST_PORT=3000
# Required in production — enables /editor (default off when NODE_ENV=production).
ZAOLY_EDITOR_INAPP=1

# Required secrets
AUTH_SECRET=
ZAOLY_POSTGRES_PASSWORD=
ZAOLY_DATABASE_URL=postgresql://zaoly:replace-me@zaoly-postgres:5432/zaoly
ZAOLY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ZAOLY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional Google OAuth (Auth.js). Redirect: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Public signup default on with Postgres; kill-switch:
# ZAOLY_PUBLIC_SIGNUP=0
# Promote these emails to platform_admin (comma-separated):
# ZAOLY_PLATFORM_ADMIN_EMAILS=admin@example.com
# Impersonation (“view as”) — leave unset on most self-host installs:
# ZAOLY_PLATFORM_ADMIN_IMPERSONATION=1

# --- System mail (self-host Profile B) ---
# Do NOT set ZAOLY_SMTP_MANAGED on self-host (that lock is for zaoly.app only).
# Either fill env below or configure Admin → Mail after login.
# ZAOLY_SMTP_HOST=
# ZAOLY_SMTP_PORT=587
# ZAOLY_SMTP_USER=
# ZAOLY_SMTP_PASS=
# ZAOLY_SMTP_FROM=noreply@example.com
# ZAOLY_SMTP_FROM_NAME=Zaoly
# ZAOLY_SMTP_TLS=starttls

# --- Storyblok CMS handoff (optional; default off) ---
# ZAOLY_STORYBLOK_HANDOFF=1
# STORYBLOK_SPACE_ID=
# STORYBLOK_MANAGEMENT_TOKEN=
